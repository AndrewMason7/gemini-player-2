# ==============================================================================
# SECTION 1: GEMINI LIVE API (VOICE & REAL-TIME STREAMING)
# ==============================================================================
# Google AI Studio API Key (Get from: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Live bidirectional streaming model and voice persona
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE_NAME=Puck

# ==============================================================================
# SECTION 2: GOOGLE ANTIGRAVITY SDK (PAIR PROGRAMMER & WORKSPACE)
#
# Choose ONE of the two options below for the coding worker:
#
# --- OPTION A: Google AI Studio (Default & Simple) ---
# If you leave the Vertex variables below commented out or empty, Antigravity
# automatically uses the same GEMINI_API_KEY from Section 1 above. No extra setup needed!
#
# --- OPTION B: Google Cloud / Vertex AI (ADC) ---
# Uncomment the 3 lines below if you want Antigravity to run through your Google Cloud project:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
# GOOGLE_CLOUD_LOCATION=global
# ==============================================================================
